{
  "_about": [
    "Context windows (tokens) and largest output (tokens) for common model families, used when the provider's own model list does not say.",
    "Rules are tried in order; `match` is a regular expression searched in the lower-cased model id (OpenRouter-style 'vendor/model' ids match too).",
    "Numbers are the vendors' published limits as known on 2026-11-07 (Anthropic, Google AI, OpenAI, DeepSeek, Mistral, xAI model pages; Groq/Cerebras/Together model lists for open models). Where a family's members differ, the smaller value is used.",
    "A request that still fails with a context-length error lowers the limit for that model (source 'learned', kept in the database)."
  ],
  "default": {
    "context": 150000,
    "max_output": null,
    "why": "Unknown model: the owner's choice (2026-11-07). OpenRouter /models measured by the owner that day: 460 models with context_length; median 400k, 25th percentile ~171k, 10th percentile ~128k; models from less-famous vendors (not openai/anthropic/google/x-ai/meta-llama/mistralai/deepseek/qwen, n=191) median 262,144. A context-length error lowers it for that model (learned)."
  },
  "rules": [
    {
      "match": "^(opus|sonnet|haiku)$",
      "context": 200000,
      "max_output": 32000,
      "note": "Claude CLI aliases"
    },
    {
      "match": "claude-haiku-4[.-]5",
      "context": 200000,
      "max_output": 64000
    },
    {
      "match": "claude-(fable|mythos)-5|claude-(opus|sonnet|haiku)-5|claude-opus-4[.-][678]|claude-sonnet-4[.-]6",
      "context": 1000000,
      "max_output": 128000
    },
    {
      "match": "claude-3-(haiku|opus|sonnet)|claude-3-(haiku|opus|sonnet)-",
      "context": 200000,
      "max_output": 4096
    },
    {
      "match": "claude-3[.-]5",
      "context": 200000,
      "max_output": 8192
    },
    {
      "match": "claude-3[.-]7",
      "context": 200000,
      "max_output": 64000
    },
    {
      "match": "claude-(opus-)?4([.-][01])?(-|$)|claude-opus-4",
      "context": 200000,
      "max_output": 32000
    },
    {
      "match": "claude",
      "context": 200000,
      "max_output": 64000
    },
    {
      "match": "gemini-1[.]5-pro",
      "context": 2097152,
      "max_output": 8192
    },
    {

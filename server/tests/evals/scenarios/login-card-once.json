{
  "name": "login-card-once",
  "about": "Asking for the same login twice in one reply leaves one open login card.",
  "profile": {
    "model": "scripted"
  },
  "user": [
    "Sign in to my shop account at shop.example.com"
  ],
  "model": [
    [
      {
        "tool": "request_login",
        "args": {
          "site": "https://shop.example.com/login"
        }
      }
    ],
    [
      {
        "tool": "request_login",
        "args": {
          "site": "https://shop.example.com/login"
        }
      }
    ],
    [
      {
        "text": "I need your sign-in for the shop; please fill in the card."
      }
    ]
  ],
  "real": [
    "request_login"
  ],
  "expect": {
    "login_cards": 1,
    "reply_contains": [
      "sign-in"
    ]
  }
}

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- voice input in the chat's composer (asked on the first tap of the mic) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- replies, approvals, payments and automatic runs while the app is closed (asked after the first message) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- keeping a reply going for a few minutes after the app is left (ReplyService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- the phone's own calendar, read only and only after the user turns on 휴대폰 캘린더 (asked then) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- adding or changing events in the phone calendar, only after the user also turns on "일정 추가·수정도 허용" (asked then); every
         change is approved on a card first -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 연락처: names, numbers, emails, company, birthdays, read only and only after the user turns it on (asked then) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- the phone's location for the briefing's weather and "near me" questions (asked when the briefing's weather is turned on or
         from its "allow" button): precise or approximate, whichever the owner picks in the system dialog; only when the app is
         opened (no background location), sent only to the owner's own Kelo server -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Health Connect: only the kinds the user ticks are asked for (read only, while the app is open) -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!-- the 15-minute notification check stays planned after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- the phone's speech recognition service has to be visible to the app (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- the phone's text-to-speech engines (Read aloud on a reply) -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Health Connect -->
        <package android:name="com.google.android.apps.healthdata" />
        <!-- the dialer the agent may open (ACTION_DIAL, the user presses call) -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!-- Google Pay's card scan library (play-services-wallet) brings Google Maps' client, which asks for these; Kelo shows no map -->
        <package android:name="com.google.android.apps.maps" tools:node="remove" />
    </queries>
    <uses-feature android:glEsVersion="0x00020000" tools:node="remove" />

    <application
        android:name=".KeloApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kelo"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">
        <uses-library android:name="org.apache.http.legacy" tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Kelo.Starting"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize">
            <!-- fold, unfold and a window resize are handled by the activity itself: the chat draft, the open tab and a live view stay -->
            <meta-data android:name="android.supports_size_changes" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- shared from another app: text goes into the chat's draft, a document is uploaded for the agent -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel.sheet.macroEnabled.12" />
            </intent-filter>
            <!-- "Kelo" in a text selection's menu -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Allow / Deny and Reply from a notification: reached only by the notification's own PendingIntent -->
        <receiver
            android:name=".notify.ApprovalActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".notify.ReplyActionReceiver"
            android:exported="false" />

        <!-- a reply the chat follows, kept alive for at most 10 minutes after the app goes to the background -->
        <service
            android:name=".notify.ReplyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Health Connect: why Kelo asks and the privacy policy (Android 13 and older: the rationale action; 14+: the alias) -->
        <activity
            android:name=".device.HealthRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.Kelo">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".device.HealthRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- the 15-minute check for news (GET /api/notifications), run by the system's JobScheduler -->
        <service
            android:name=".notify.PollJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- push: data messages {type, id} from Firebase Cloud Messaging; the details come from the user's own server -->
        <service
            android:name=".notify.KeloMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="replies" />

        <!-- the camera app writes the photo for an attachment here (cache/camera), through a content address it is allowed to use -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

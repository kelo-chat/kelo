"privacy_bodies##0" = "Loginy do stron i klucze API są szyfrowane AES-256 i przechowywane tylko na serwerze Kelo, który sam uruchamiasz. Nigdy nie trafiają do kelo.chat ani do twórcy aplikacji. Każdy jest powiązany ze stronami, na których wolno go użyć, więc nie da się go użyć nigdzie indziej. Wartości nigdy nie są pokazywane ponownie – ani na ekranie, ani agentowi.";
"privacy_bodies##1" = "Hasła nigdy nie trafiają do czatu, tylko do osobnego pola Pęku kluczy. Agent wie jedynie, że hasło istnieje, a serwer wpisuje je na zarejestrowanej stronie. Każde użycie trafia do dziennika użycia, którego agent nie może odczytać ani usunąć.";
"privacy_bodies##2" = "Historia czatów, przesłane dokumenty i notatki są przechowywane na komputerze, na którym działa serwer Kelo. To, co wysyłasz w czacie, trafia jednak do wybranej usługi AI (dostawcy modelu).";
"privacy_bodies##3" = "Domyślnie agent prosi o zgodę, zanim coś kliknie lub wpisze w sieci, zapisze coś w połączonych usługach albo zrobi coś płatnego (np. utworzy obrazy).";
"privacy_bodies##4" = "W sekcji Moje urządzenia możesz odłączyć każdy telefon osobno. Odłączenie jednego nie wpływa na pozostałe.";
"privacy_bodies##5" = "Twój agent nie może uruchamiać poleceń na serwerze Kelo. Obsługuje pliki i sieć tylko ustalonymi narzędziami i może otwierać tylko publiczne adresy WWW.";
"privacy_bodies##6" = "Strony, poczta i pliki są czytane jako informacja, nigdy jako polecenia. Jeśli taki tekst próbuje sprawić, by Kelo przeniósł twoje dane lub pieniądze, Kelo go ignoruje i daje ci znać. Każde wysłanie, zmiana lub usunięcie czeka na twoją zgodę.";
"privacy_bodies##7" = "Rozmowy, pliki, notatki, klucze i karty są przechowywane tylko na serwerze Kelo, który prowadzisz. kelo.chat ich nie przechowuje. Jedynym wyjątkiem jest odpowiedź, którą sam zdecydujesz się zgłosić.";
"privacy_bodies##count" = "8";

"privacy_bodies##0" = "वेबसाइट लॉगिन और API कुंजियाँ AES-256 से एन्क्रिप्ट होकर सिर्फ़ उसी Kelo सर्वर पर सहेजी जाती हैं जिसे आप चलाते हैं। ये कभी kelo.chat या डेवलपर के पास नहीं जातीं। हर एक उन्हीं साइटों से जुड़ी है जिन पर उसकी अनुमति है, इसलिए कहीं और इस्तेमाल नहीं हो सकती। मान फिर कभी नहीं दिखाए जाते, न स्क्रीन पर और न आपके एजेंट को।";
"privacy_bodies##1" = "पासवर्ड कभी चैट में नहीं जाते, सिर्फ़ कीचेन के अपने इनपुट फ़ील्ड में डाले जाते हैं। आपका एजेंट बस इतना जानता है कि एक पासवर्ड मौजूद है, और सर्वर उसे आपकी रजिस्टर की गई साइट पर भरता है। हर इस्तेमाल इस्तेमाल-लॉग में दर्ज होता है, जिसे आपका एजेंट न पढ़ सकता है न मिटा सकता है।";
"privacy_bodies##2" = "आपकी चैट हिस्ट्री, अपलोड किए दस्तावेज़ और नोट्स उस कंप्यूटर पर सहेजे जाते हैं जिस पर Kelo सर्वर चलता है। हाँ, चैट में आप जो भेजते हैं वह आपकी चुनी हुई AI सेवा (आपके मॉडल प्रदाता) को जाता है।";
"privacy_bodies##3" = "डिफ़ॉल्ट रूप से आपका एजेंट वेब पर क्लिक करने या टाइप करने, कनेक्ट की गई सर्विस में लिखने, या पैसे लगने वाले काम (जैसे इमेज बनाना) करने से पहले मंज़ूरी माँगता है।";
"privacy_bodies##4" = "\"मेरे डिवाइस\" में आप हर फ़ोन को अलग से डिस्कनेक्ट कर सकते हैं। एक को डिस्कनेक्ट करने से बाकी वैसे ही रहते हैं।";
"privacy_bodies##5" = "आपका एजेंट Kelo सर्वर पर कमांड नहीं चला सकता। वह सिर्फ़ तय टूल से फ़ाइलें और वेब संभालता है, और सिर्फ़ सार्वजनिक वेब पते खोल सकता है।";
"privacy_bodies##6" = "वेबपेज, मेल और फ़ाइलों को जानकारी के रूप में पढ़ा जाता है, आदेश के रूप में नहीं। अगर ऐसा टेक्स्ट Kelo से आपका डेटा या पैसा हिलवाने की कोशिश करे, तो Kelo उसे अनदेखा करके आपको बताता है। कुछ भी भेजना, बदलना या हटाना आपकी मंज़ूरी का इंतज़ार करता है।";
"privacy_bodies##7" = "चैट, फ़ाइलें, नोट, कुंजियाँ और कार्ड केवल उस Kelo सर्वर पर सहेजे जाते हैं जिसे आप चलाते हैं। kelo.chat इन्हें नहीं रखता। एकमात्र अपवाद वह जवाब है जिसकी रिपोर्ट आप खुद करें।";
